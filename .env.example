# =========================================================================
#                    SOCIALNEST FULL-STACK ENVIRONMENT VARIABLES
# =========================================================================

# Server Deployment Profile
NODE_ENV=production
PORT=10000

# Security (Set to your Render frontend URL)
CORS_ORIGIN=https://socialnest.onrender.com

# MongoDB Atlas Production URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/socialnest

# JWT Secrets (Run 'openssl rand -hex 64' to generate strong keys)
ACCESS_TOKEN_SECRET=3bc32db820ef0d9f0a20a40d51ef77f1
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=8e2bc102bc0da2a1ab0fca02d189efcb
REFRESH_TOKEN_EXPIRY=7d
VERIFICATION_TOKEN_SECRET=92bcda02bc112eaefac2ea3302bc1298

# Upstash Redis Production Details
REDIS_HOST=your-redis-endpoint.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_redis_password

# ImageKit Assets Hosting CDN (Optional)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint_id

# Email SMTP Delivery Configuration (e.g. Zoho, SendGrid)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=no-reply@socialnest.in
SMTP_PASS=your_smtp_app_password
EMAIL_FROM=SocialNest <no-reply@socialnest.in>
